name: Build RMV Ebook Reader APK
on:
  workflow_dispatch:
  push:
    branches: [ main ]
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unpack Android project
        run: unzip -q RMV_Ebook_Reader_Lavender_Android_Project.zip -d source
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Build debug APK
        run: gradle -p source/RMV_Ebook_Reader_Android assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: RMV-Ebook-Reader-Lavender-APK
          path: source/RMV_Ebook_Reader_Android/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 7
